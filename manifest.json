{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "OpenNDM",
  "version": "0.1.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "homepage_url": "https://www.neatdownloadmanager.com/",
  "icons": {
    "16": "img/openndm-16.png",
    "32": "img/openndm-32.png",
    "48": "img/openndm-48.png",
    "128": "img/openndm-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "img/openndm-16.png",
      "32": "img/openndm-32.png",
      "48": "img/openndm-48.png",
      "128": "img/openndm-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "cookies",
    "downloads",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/catcher.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
